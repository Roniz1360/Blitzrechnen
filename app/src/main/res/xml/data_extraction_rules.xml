<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): weder Cloud-Backup noch Gerät-zu-Gerät-Transfer
     dürfen die lokalen Kinderdaten (Name, Fortschritt, PIN) kopieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
