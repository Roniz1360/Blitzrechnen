<?xml version="1.0" encoding="utf-8"?>
<!-- Backups sind deaktiviert (allowBackup=false). Diese Regeln schliessen
     zusätzlich alle App-Daten aus, falls Backups je aktiviert würden. -->
<full-backup-content>
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
